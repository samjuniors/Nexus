<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext HTTP for local LAN IPs and USB ADB reverse tunnels (127.0.0.1 / 10.0.2.2)
         while supporting standard HTTPS cloud deployments out of the box. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
