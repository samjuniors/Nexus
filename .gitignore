# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep secrets out, but the example template IS committed
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log

# runtime state (created on first run, not source)
/db/
/tool-results/
/agent-workspace/
/upload/
/download/

# Skills directory (local, machine-specific)
/skills/
# Nexus offline disaster-recovery snapshots — never commit real user databases
/backups/
/prisma/*.db
/prisma/*.db-*
/prisma/db/
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
