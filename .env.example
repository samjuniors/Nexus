# ──────────────────────────────────────────────────────────────────────
# NEXUS AGENT — environment configuration
#
# Copy this file to `.env` and fill in what you have. EVERYTHING here is
# optional: with no keys at all the app runs on the built-in GLM SDK
# (z-ai-web-dev-sdk) — that is always the fallback. Add a key and the app
# prefers that provider, falling back to the built-in SDK if it fails.
# ──────────────────────────────────────────────────────────────────────

# ── Database (SQLite via Prisma) ──
DATABASE_URL="file:./db/custom.db"

# ── LLM providers ─────────────────────────────────────────────────────
# Priority: OPENAI_API_KEY → ANTHROPIC_API_KEY → built-in GLM SDK.
# Any provider failure (network, 429, 5xx) falls back down the chain —
# the app never goes dark.

# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Groq, Together,
# DeepSeek, LM Studio, Ollama (http://localhost:11434/v1), vLLM, ...
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Built-in GLM via z-ai-web-dev-sdk needs no key — it is the fallback.

# ── Web search (optional — falls back to the built-in SDK search) ────
# Tavily: https://tavily.com (free tier available)
#TAVILY_API_KEY=

# ── Notes ─────────────────────────────────────────────────────────────
# - Restart the dev server after changing .env for values to load.
# - Never commit your real .env — only this .env.example template.
