# Nexus: fixed upstream only. The previous XTransformPort query routing
# allowed client-controlled proxy destinations and is intentionally removed.
# Use a separate trusted HTTPS terminator for public access and set
# NEXUS_PUBLIC_ORIGIN plus NEXUS_OWNER_TOKEN.
:81 {
	reverse_proxy 127.0.0.1:3000 {
		header_up Host {host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
